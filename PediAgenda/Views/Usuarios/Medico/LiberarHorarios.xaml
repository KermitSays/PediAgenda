<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Medico.LiberarHorarios"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Liberar períodos"
    BackgroundColor="{StaticResource PageBlue}">

    <Grid
        Padding="24,30,24,20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="18">

        <!-- CABEÇALHO -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="10">

            <Label
                Text="Liberar períodos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Label
                Text="Selecione um período bloqueado para liberar. Consultas canceladas não serão restauradas."
                FontSize="14"
                TextColor="{StaticResource InputPlaceholder}" />

            <Label x:Name="EstadoLabel" TextColor="{StaticResource TextDark}" />
            <Button x:Name="AtualizarButton" Text="Atualizar bloqueios" Clicked="AtualizarButton_Clicked" />

        </VerticalStackLayout>

        <!-- LISTA DE BLOQUEIOS -->
        <CollectionView
            Grid.Row="1"
            x:Name="BloqueiosCollectionView"
            IsVisible="False"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource InputBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">

                            <!-- DATA DO BLOQUEIO -->
                            <Label
                                Text="{Binding PeriodoData}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <!-- HORÁRIO DO BLOQUEIO -->
                            <Label
                                Text="{Binding PeriodoHorario}"
                                FontSize="16"
                                TextColor="{StaticResource PrimaryBlue}" />

                            <!-- LIBERAR PERÍODO -->
                            <Button
                                Text="LIBERAR TODO O PERÍODO"
                                HeightRequest="52"
                                CornerRadius="16"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                Clicked="LiberarPeriodoButton_Clicked" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- LISTA VAZIA -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="10"
                    VerticalOptions="Center">

                    <Label
                        Text="Nenhum período bloqueado."
                        FontSize="17"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        Text="Os períodos bloqueados pelo médico aparecerão aqui."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource InputPlaceholder}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <!-- BOTÃO VOLTAR -->
        <Button
            Grid.Row="2"
            Text="Voltar"
            Style="{StaticResource BotaoVoltarSimples}"
            Clicked="VoltarButton_Clicked"
            HorizontalOptions="Center" />

    </Grid>

</ContentPage>

