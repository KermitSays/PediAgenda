<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Medico.PacientesMedico"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PediAgenda.Controls"
    Title="Pacientes"
    BackgroundColor="{StaticResource PageBlue}"
    Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="24,30,24,20"
        RowSpacing="20">

        <!-- CABEÇALHO -->
        <Label
            Grid.Row="0"
            Text="Pacientes"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="{StaticResource TextDark}" />

        <!-- BUSCA -->
        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource White}"
            Stroke="{StaticResource InputBlue}"
            StrokeThickness="1"
            Padding="14,0"
            StrokeShape="RoundRectangle 14"
            HeightRequest="52">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">

                <Label
                    Grid.Column="0"
                    Text="⌕"
                    FontSize="25"
                    TextColor="{StaticResource InputPlaceholder}"
                    VerticalOptions="Center" />

                <Entry
                    Grid.Column="1"
                    x:Name="BuscarPacienteEntry"
                    Placeholder="Buscar paciente..."
                    PlaceholderColor="{StaticResource InputPlaceholder}"
                    TextColor="{StaticResource TextDark}"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    ClearButtonVisibility="WhileEditing"
                    TextChanged="BuscarPacienteEntry_TextChanged"
                    VerticalOptions="Center" />

            </Grid>

        </Border>

        <!-- LISTA DE PACIENTES -->
        <CollectionView
            Grid.Row="2"
            x:Name="PacientesCollectionView"
            ItemsSource="{Binding PacientesFiltrados}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12" />
            </CollectionView.ItemsLayout>


            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
            BackgroundColor="{StaticResource White}"
            Stroke="{StaticResource InputBlue}"
            StrokeThickness="1"
            Padding="16"
            StrokeShape="RoundRectangle 16">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                    Tapped="PacientesMedico_Clicked" />
                        </Border.GestureRecognizers>

                        <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">

                            <!-- INFORMAÇÕES DO PACIENTE -->
                            <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="5"
                    VerticalOptions="Center">

                                <Label
                        Text="{Binding Nome}"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                                <Label
                        Text="{Binding Responsavel, StringFormat='Responsável: {0}'}"
                        FontSize="14"
                        TextColor="{StaticResource InputPlaceholder}" />

                            </VerticalStackLayout>

                            <!-- SETA -->
                            <Label
                    Grid.Column="1"
                    Text="›"
                    FontSize="30"
                    TextColor="{StaticResource PrimaryBlue}"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>


            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="Nenhum paciente encontrado"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Tente pesquisar por outro nome."
                        FontSize="14"
                        TextColor="{StaticResource InputPlaceholder}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <!-- Retorno ao menu anterior -->
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label x:Name="EstadoLabel" TextColor="Black" IsVisible="False" />
            <controls:BotaoVoltar />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
