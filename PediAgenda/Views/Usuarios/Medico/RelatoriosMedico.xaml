<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Medico.RelatoriosMedico"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Relatórios"
    BackgroundColor="{StaticResource PageBlue}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,30,24,24"
            Spacing="20">

            <!-- TÍTULO -->
            <Label
                Text="Relatório de atendimentos"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Label
                Text="Consulte as consultas realizadas em um determinado período."
                FontSize="14"
                TextColor="{StaticResource InputPlaceholder}" />

            <!-- FILTRO POR PERÍODO -->
            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Período"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                    <!-- DATA INICIAL -->
                    <Label
                        Text="Data inicial"
                        FontSize="15"
                        TextColor="{StaticResource TextDark}" />

                    <Border
                        BackgroundColor="{StaticResource PageBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,4">

                        <DatePicker
                            x:Name="DataInicialPicker"
                            Format="dd/MM/yyyy"
                            TextColor="{StaticResource TextDark}" />
                    </Border>

                    <!-- DATA FINAL -->
                    <Label
                        Text="Data final"
                        FontSize="15"
                        TextColor="{StaticResource TextDark}" />

                    <Border
                        BackgroundColor="{StaticResource PageBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,4">

                        <DatePicker
                            x:Name="DataFinalPicker"
                            Format="dd/MM/yyyy"
                            TextColor="{StaticResource TextDark}" />
                    </Border>

                    <!-- BUSCAR -->
                    <Button
                        Text="BUSCAR ATENDIMENTOS"
                        HeightRequest="52"
                        CornerRadius="16"
                        BackgroundColor="{StaticResource PrimaryBlue}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        Clicked="BuscarButton_Clicked" />

                </VerticalStackLayout>
            </Border>

            <!-- RESUMO -->
            <Label
                Text="Resumo"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout
                    Spacing="6"
                    HorizontalOptions="Center">

                    <Label
                        x:Name="TotalRealizadasLabel"
                        Text="0"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryBlue}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Consultas realizadas"
                        FontSize="15"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- LISTA DE ATENDIMENTOS -->
            <Label
                Text="Atendimentos encontrados"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <CollectionView
                ItemsSource="{Binding Resultados}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource InputBlue}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="16">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Paciente}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                                <Label
                                    Text="{Binding DataHoraFormatada}"
                                    FontSize="14"
                                    TextColor="{StaticResource PrimaryBlue}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="20"
                        Spacing="8">

                        <Label
                            Text="Nenhum atendimento encontrado"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Não existem consultas realizadas no período selecionado."
                            FontSize="14"
                            TextColor="{StaticResource InputPlaceholder}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>

            <!-- EXPORTAR EXCEL -->
            <Button
                Text="GERAR EXCEL"
                HeightRequest="52"
                CornerRadius="16"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="{StaticResource White}"
                FontAttributes="Bold"
                Clicked="GerarExcelButton_Clicked" />

            <!-- VOLTAR -->
            <Button
                Text="Voltar"
                Style="{StaticResource BotaoVoltarSimples}"
                Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
