<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Medico.BloquearHorario"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Bloquear período"
    BackgroundColor="{StaticResource PageBlue}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,24"
            Spacing="18">

            <!-- TÍTULO -->
            <Label
                Text="Bloquear período"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <!-- AVISO -->
            <Label
                Text="Consultas agendadas no período serão canceladas. A liberação não restaura consultas."
                FontSize="14"
                TextColor="{StaticResource InputPlaceholder}" />

            <!-- DATA INICIAL -->
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="Data inicial"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <DatePicker
                        x:Name="DataInicialPicker"
                        Format="dd/MM/yyyy"
                        TextColor="{StaticResource TextDark}"
                        MinimumDate="{x:Static sys:DateTime.Today}" />

                </Border>

            </VerticalStackLayout>

            <!-- DATA FINAL -->
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="Data final"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <DatePicker
                        x:Name="DataFinalPicker"
                        Format="dd/MM/yyyy"
                        TextColor="{StaticResource TextDark}"
                        MinimumDate="{x:Static sys:DateTime.Today}" />

                </Border>

            </VerticalStackLayout>

            <!-- HORÁRIO INICIAL -->
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="Horário inicial"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <TimePicker
                        x:Name="HorarioInicialPicker"
                        Format="HH:mm"
                        TextColor="{StaticResource TextDark}" />

                </Border>

            </VerticalStackLayout>

            <!-- HORÁRIO FINAL -->
            <VerticalStackLayout Spacing="7">

                <Label
                    Text="Horário final"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <TimePicker
                        x:Name="HorarioFinalPicker"
                        Format="HH:mm"
                        TextColor="{StaticResource TextDark}" />

                </Border>

            </VerticalStackLayout>

            <!-- BOTÃO BLOQUEAR -->
            <Button
                Text="BLOQUEAR PERÍODO"
                HeightRequest="52"
                CornerRadius="16"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="{StaticResource White}"
                FontAttributes="Bold"
                Clicked="BloquearHorarioButton_Clicked" />

            <!-- BOTÃO VOLTAR -->
            <Button
                Text="Voltar"
                Clicked="CancelarButton_Clicked"
                Style="{StaticResource BotaoVoltarSimples}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
