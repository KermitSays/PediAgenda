<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Recepcao.MenuRecepcao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Menu Recepção"
    BackgroundColor="{StaticResource PageBlue}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,30,24,20"
            Spacing="28">

            <!-- CABEÇALHO -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Olá, Recepção!"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    x:Name="DataAtualLabel"
                    FontSize="15"
                    TextColor="{StaticResource InputPlaceholder}" />
            </VerticalStackLayout>

            <!-- MENU -->
            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,*"
                RowSpacing="28"
                ColumnSpacing="20">

                <!-- PACIENTES -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="PacientesButton_Clicked" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="paciente_icon.png"
                        WidthRequest="95"
                        HeightRequest="95"
                        Aspect="AspectFit" />

                    <Label
                        Text="Pacientes"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- MÉDICOS -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="MedicosButton_Clicked" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="medico_icon.png"
                        WidthRequest="95"
                        HeightRequest="95"
                        Aspect="AspectFit" />

                    <Label
                        Text="Médicos"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- CADASTRAR RESPONSÁVEL -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="CadastrarResponsavelButton_Clicked" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border
                        WidthRequest="95"
                        HeightRequest="95"
                        BackgroundColor="{StaticResource PrimaryBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                        <Image
                            Source="user.png"
                            Aspect="AspectFit" />
                    </Border>

                    <Label
                        Text="Cadastrar&#10;responsável"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- CONSULTAS DE HOJE -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="ConsultasHojeButton_Clicked" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="consulta_icon.png"
                        WidthRequest="95"
                        HeightRequest="95"
                        Aspect="AspectFit" />

                    <Label
                        Text="Consultas de hoje"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>