<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Recepcao.MenuRecepcao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PediAgenda.Controls"
    Title="Menu Recepção"
    BackgroundColor="{StaticResource PageBlue}">

    <Grid
        RowDefinitions="Auto,Auto,*"
        Padding="24,30,24,20">

        <!-- ======================================
             CABEÇALHO
             ====================================== -->

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Grid.Row="0" Margin="0,0,0,20">
    <VerticalStackLayout Grid.Column="0" Spacing="4">

            <Label
                x:Name="SaudacaoLabel"
                Text="Olá!"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Label
                x:Name="DataAtualLabel"
                FontSize="15"
                TextColor="{StaticResource InputPlaceholder}" />

        </VerticalStackLayout>
    <controls:BotaoLogoff Grid.Column="1" />
</Grid>


        <!-- ======================================
             MENU
             ====================================== -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="28"
            Margin="0,0,0,24">

            <!-- PACIENTES -->

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="6"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="PacientesButton_Clicked" />

                </VerticalStackLayout.GestureRecognizers>

                <Image
                    Source="paciente_icon.png"
                    WidthRequest="95"
                    HeightRequest="95"
                    Aspect="AspectFit" />

                <Label
                    Text="Pacientes"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- MÉDICOS -->

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="6"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="MedicosButton_Clicked" />

                </VerticalStackLayout.GestureRecognizers>

                <Image
                    Source="medico_icon.png"
                    WidthRequest="95"
                    HeightRequest="95"
                    Aspect="AspectFit" />

                <Label
                    Text="Médicos"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


        </Grid>


        <!-- ======================================
             CONSULTAS DO DIA
             ====================================== -->

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <Label
                    Text="Consultas de hoje"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    x:Name="QuantidadeConsultasLabel"
                    Grid.Column="1"
                    FontSize="13"
                    TextColor="{StaticResource InputPlaceholder}"
                    VerticalOptions="Center" />

            </Grid>


            <!-- ==================================
                 PUXAR PARA ATUALIZAR
                 ================================== -->

            <RefreshView
                Grid.Row="1"
                x:Name="ConsultasRefreshView"
                Refreshing="ConsultasRefreshView_Refreshing">

                <CollectionView
                    x:Name="ConsultasCollectionView"
                    ItemsSource="{Binding ConsultasHoje}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>

                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="12" />

                    </CollectionView.ItemsLayout>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BackgroundColor="White"
                                Stroke="{StaticResource InputBlue}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 16">

                                <Grid
                                    ColumnDefinitions="70,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- HORÁRIO -->

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Horario}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryBlue}"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="Center" />


                                    <!-- PACIENTE / MÉDICO -->

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Paciente}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextDark}" />

                                        <Label
                                            Text="{Binding Medico}"
                                            FontSize="13"
                                            TextColor="{StaticResource InputPlaceholder}" />

                                    </VerticalStackLayout>


                                    <!-- STATUS -->

                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{StaticResource PageBlue}"
                                        StrokeThickness="0"
                                        Padding="10,6"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource PrimaryBlue}" />

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>




                </CollectionView>

            </RefreshView>

            <!-- Estado vazio controlado apos carregar consultas; independente da altura da CollectionView. -->
            <VerticalStackLayout
                x:Name="SemConsultasContainer"
                Grid.Row="1"
                IsVisible="False"
                InputTransparent="True"
                Padding="20,18,20,0"
                Spacing="6"
                HorizontalOptions="Fill"
                VerticalOptions="Start">

                <Label
                    Text="Nenhuma consulta hoje"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Não há consultas agendadas para hoje."
                    FontSize="14"
                    TextColor="{StaticResource InputPlaceholder}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>