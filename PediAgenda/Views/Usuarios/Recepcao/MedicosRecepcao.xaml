<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Recepcao.MedicosRecepcao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Médicos"
    BackgroundColor="{StaticResource PageBlue}">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="20,24,20,18"
        RowSpacing="16">

        <!-- CABEÇALHO -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="12">

            <Label
                Text="Médicos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Label
                Text="Consulte e gerencie os horários dos médicos."
                FontSize="14"
                TextColor="{StaticResource InputPlaceholder}" />


            <!-- MÉDICO -->

            <VerticalStackLayout
                Spacing="6">

                <Label
                    Text="Médico"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />


                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 14">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                x:Name="MedicoSelecionadoLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <Label
                                Text="Toque para selecionar outro médico"
                                FontSize="11"
                                TextColor="{StaticResource InputPlaceholder}" />

                        </VerticalStackLayout>


                        <Label
                            Grid.Column="1"
                            Text="⌕"
                            FontSize="25"
                            TextColor="{StaticResource PrimaryBlue}"
                            VerticalOptions="Center" />


                        <!-- Botão transparente sobre o campo inteiro -->

                        <Button
                            Grid.ColumnSpan="2"
                            BackgroundColor="Transparent"
                            Opacity="0.01"
                            Clicked="SelecionarMedicoButton_Clicked" />

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- DATA -->

            <VerticalStackLayout
                Spacing="6">

                <Label
                    Text="Data"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="10,3"
                    StrokeShape="RoundRectangle 14">

                    <DatePicker
                        x:Name="DataPicker"
                        Format="dd/MM/yyyy"
                        TextColor="{StaticResource TextDark}"
                        DateSelected="DataPicker_DateSelected" />

                </Border>

            </VerticalStackLayout>


            <!-- HORÁRIOS -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,4,0,0">

                <Label
                    Text="Horários"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    x:Name="QuantidadeHorariosLabel"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    FontSize="13"
                    TextColor="{StaticResource PrimaryBlue}" />

            </Grid>

        </VerticalStackLayout>


        <!-- AGENDA -->

        <CollectionView
            Grid.Row="1"
            x:Name="AgendaCollectionView"
            ItemsSource="{Binding HorariosFiltrados}"
            SelectionMode="Single"
            SelectionChanged="AgendaCollectionView_SelectionChanged">

            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="10" />

            </CollectionView.ItemsLayout>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="{StaticResource InputBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="65,*,Auto"
                            ColumnSpacing="12">

                            <Label
                                Grid.Column="0"
                                Text="{Binding HorarioFormatado}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center" />


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding PacienteExibicao}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                                <Label
                                    Text="{Binding Descricao}"
                                    FontSize="13"
                                    TextColor="{Binding StatusCor}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="2"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Spacing="2">

                                <Label
                                    Text="{Binding StatusVisual}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding StatusCor}"
                                    HorizontalTextAlignment="End" />

                                <Label
                                    Text="›"
                                    FontSize="24"
                                    TextColor="{StaticResource PrimaryBlue}"
                                    HorizontalTextAlignment="End" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>


            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="24"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="Nenhum horário encontrado."
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        Text="Selecione outro médico ou outra data."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource InputPlaceholder}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>


        <!-- AÇÕES -->

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="10">

            <Button
                Text="BLOQUEAR HORÁRIO"
                HeightRequest="50"
                CornerRadius="16"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="BloquearHorarioButton_Clicked" />

            <Button
                Text="LIBERAR HORÁRIOS"
                HeightRequest="50"
                CornerRadius="16"
                BackgroundColor="White"
                TextColor="{StaticResource PrimaryBlue}"
                BorderColor="{StaticResource PrimaryBlue}"
                BorderWidth="1"
                FontAttributes="Bold"
                Clicked="LiberarHorariosButton_Clicked" />

            <Button
                Text="Voltar"
                HeightRequest="48"
                CornerRadius="16"
                BackgroundColor="White"
                TextColor="{StaticResource PrimaryBlue}"
                BorderColor="{StaticResource PrimaryBlue}"
                BorderWidth="1"
                Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>