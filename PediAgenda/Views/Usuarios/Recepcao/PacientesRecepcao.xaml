<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Recepcao.PacientesRecepcao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pacientes"
    BackgroundColor="{StaticResource PageBlue}">

    <Grid
        RowDefinitions="Auto,*"
        Padding="24,24,24,20">

        <!-- CABEÇALHO -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="14"
            Margin="0,0,0,18">

            <Label
                Text="Pacientes"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="{StaticResource TextDark}" />

            <Label
                Text="Consulte os pacientes cadastrados na clínica."
                FontSize="14"
                TextColor="{StaticResource InputPlaceholder}" />

            <!-- BUSCA -->
            <Border
                BackgroundColor="White"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                Padding="10,2"
                StrokeShape="RoundRectangle 16">

                <SearchBar
                    x:Name="PacienteSearchBar"
                    Placeholder="Buscar por nome do paciente"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextDark}"
                    PlaceholderColor="{StaticResource InputPlaceholder}"
                    TextChanged="PacienteSearchBar_TextChanged" />

            </Border>

        </VerticalStackLayout>


        <!-- LISTA -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding PacientesFiltrados}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12" />
            </CollectionView.ItemsLayout>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="{StaticResource InputBlue}"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 16">

                        <Grid
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*,Auto"
                            RowSpacing="5">

                            <!-- NOME -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Nome}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <!-- STATUS -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="{StaticResource PageBlue}"
                                StrokeThickness="0"
                                Padding="9,5"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="{Binding Status}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource PrimaryBlue}" />

                            </Border>


                            <!-- RESPONSÁVEL -->
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding ResponsavelFormatado}"
                                FontSize="14"
                                TextColor="{StaticResource InputPlaceholder}" />

                            <!-- NASCIMENTO -->
                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Text="{Binding NascimentoFormatado}"
                                FontSize="14"
                                TextColor="{StaticResource InputPlaceholder}" />

                            <!-- ACESSAR PACIENTE -->
                            <Button
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Text="ACESSAR PACIENTE"
                                Margin="0,10,0,0"
                                HeightRequest="44"
                                CornerRadius="22"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CommandParameter="{Binding .}"
                                Clicked="DetalhesButton_Clicked" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>


            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <Label
                        Text="Nenhum paciente encontrado"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Tente buscar por outro nome."
                        FontSize="14"
                        TextColor="{StaticResource InputPlaceholder}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>