<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    Shell.NavBarIsVisible="False"
    x:Class="PediAgenda.Views.Usuarios.Recepcao.DetalhesPacienteRecepcao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Paciente"
    BackgroundColor="{StaticResource PageBlue}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,24"
            Spacing="18">

            <!-- CABEÇALHO -->
            <VerticalStackLayout Spacing="4">

                <Label
                    x:Name="NomePacienteLabel"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    Text="Dados do paciente"
                    FontSize="14"
                    TextColor="{StaticResource InputPlaceholder}" />

            </VerticalStackLayout>

            <!-- DADOS DO PACIENTE -->
            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Paciente"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        x:Name="NascimentoLabel"
                        FontSize="14"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        x:Name="StatusPacienteLabel"
                        FontSize="14"
                        TextColor="{StaticResource TextDark}" />

                </VerticalStackLayout>

            </Border>

            <!-- DADOS DO RESPONSÁVEL -->
            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Responsável"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        x:Name="ResponsavelLabel"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        x:Name="TelefoneLabel"
                        FontSize="14"
                        TextColor="{StaticResource InputPlaceholder}" />

                    <Label
                        x:Name="EmailLabel"
                        FontSize="14"
                        TextColor="{StaticResource InputPlaceholder}" />

                </VerticalStackLayout>

            </Border>

            <!-- AGENDAR CONSULTA -->
            <Button
                Text="AGENDAR CONSULTA"
                HeightRequest="52"
                CornerRadius="16"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="{StaticResource White}"
                FontAttributes="Bold"
                Margin="0,10,0,0"
                Clicked="AgendarConsultaButton_Clicked" />

            <!-- VOLTAR -->
            <Button
                Text="Voltar"
                Style="{StaticResource BotaoVoltarSimples}"
                Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
