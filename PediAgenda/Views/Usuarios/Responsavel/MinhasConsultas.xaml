<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.MinhasConsultas"
    Title="Minhas consultas"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="24,30,24,24" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Minhas consultas" FontSize="28" FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}" />
            <Label Text="Selecione um paciente para visualizar suas consultas."
                   FontSize="15" TextColor="{StaticResource TextDark}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="PacientesCollectionView"
                        Margin="0,24,0,15" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="10" Margin="0,0,0,14">
                        
                        <!-- Sem avatar: card ocupa toda a largura. -->
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource InputBlue}"
                                StrokeThickness="1" Padding="14"
                                Margin="0,0,0,10"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PacienteCard_Tapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Nome}" FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextDark}" />
                                <Label Text="Toque para ver as consultas" FontSize="12"
                                       TextColor="{StaticResource InputPlaceholder}" />
                            </VerticalStackLayout>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpanded}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F3FF" />
                                    <Setter Property="Stroke" Value="{StaticResource PrimaryBlue}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- HISTÓRICO DE CONSULTAS DO PACIENTE -->

                        <VerticalStackLayout
                             IsVisible="{Binding IsExpanded}"
                             Spacing="0"
                             Padding="0,5,0,0">

                            <!-- FILTROS DO HISTÓRICO -->

                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                Margin="0,0,0,12">

                                <HorizontalStackLayout Spacing="6">

                                    <Button
                                        x:Name="BtnTodas"
                                        Text="Todas"
                                        FontSize="12"
                                        Padding="12,8"
                                        CornerRadius="12"
                                        BackgroundColor="#E8F3FF"
                                        TextColor="#1976D2"
                                        Clicked="FiltroTodas_Clicked" >

                                        <Button.Triggers>
                                            <DataTrigger
                                                  TargetType="Button"
                                                  Binding="{Binding FiltroSelecionado}"
                                                  Value="Todas">

                                                <Setter
                                                   Property="BackgroundColor"
                                                   Value="#1976D2" />

                                                <Setter
                                                   Property="TextColor"
                                                   Value="White" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>

                                    <Button
                                        x:Name="BtnAgendadas"
                                        Text="Agendadas"
                                        FontSize="12"
                                        Padding="12,8"
                                        CornerRadius="12"
                                        BackgroundColor="#E8F3FF"
                                        TextColor="#1976D2"
                                        Clicked="FiltroAgendadas_Clicked" >

                                        <Button.Triggers>
                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding FiltroSelecionado}"
                                                Value="Agendadas">

                                                <Setter
                                                   Property="BackgroundColor"
                                                   Value="#1976D2" />

                                                <Setter
                                                   Property="TextColor"
                                                   Value="White" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>

                                    <Button
                                        x:Name="BtnRealizadas"
                                        Text="Realizadas"
                                        FontSize="12"
                                        Padding="12,8"
                                        CornerRadius="12"
                                        BackgroundColor="#E8F3FF"
                                        TextColor="#1976D2"
                                        Clicked="FiltroRealizadas_Clicked" >

                                        <Button.Triggers>
                                            <DataTrigger
                                               TargetType="Button"
                                               Binding="{Binding FiltroSelecionado}"
                                               Value="Realizadas">

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="#1976D2" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="White" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>

                                    <Button
                                        x:Name="BtnCanceladas"
                                        Text="Canceladas"
                                        FontSize="12"
                                        Padding="12,8"
                                        CornerRadius="12"
                                        BackgroundColor="#E8F3FF"
                                        TextColor="#1976D2"
                                        Clicked="FiltroCanceladas_Clicked" >

                                        <Button.Triggers>
                                            <DataTrigger
                                                 TargetType="Button"
                                                 Binding="{Binding FiltroSelecionado}"
                                                 Value="Canceladas">

                                                <Setter
                                                   Property="BackgroundColor"
                                                   Value="#1976D2" />

                                                <Setter
                                                   Property="TextColor"
                                                   Value="White" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>

                                </HorizontalStackLayout>

                            </ScrollView>

                            <!-- CABEÇALHO DA TABELA -->

                            <Grid
                                ColumnDefinitions="1.5*,1.4*,1.1*"
                                ColumnSpacing="12"
                                Padding="8,10"
                                BackgroundColor="#E8F3FF">

                                <Label
                                     Grid.Column="0"
                                     Text="Data / Hora"
                                     FontSize="12"
                                     FontAttributes="Bold"
                                     TextColor="{StaticResource TextDark}" />

                                <Label
                                     Grid.Column="1"
                                     Text="Médico"
                                     FontSize="12"
                                     FontAttributes="Bold"
                                     TextColor="{StaticResource TextDark}" />

                                <Label
                                     Grid.Column="2"
                                     Text="Status"
                                     FontSize="12"
                                     FontAttributes="Bold"
                                     TextColor="{StaticResource TextDark}" />

                            </Grid>

                            <!-- LINHAS DAS CONSULTAS -->

                            <VerticalStackLayout
                                  BindableLayout.ItemsSource="{Binding TodasConsultasOrdenadas, Mode=OneWay}"
                                  Spacing="0">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>

                                        <VerticalStackLayout Spacing="0">

                                            <Grid
                                              ColumnDefinitions="1.5*,1.4*,1.1*"
                                              ColumnSpacing="12"
                                              Padding="8,12">

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Tapped="ConsultaCard_Tapped" />
                                                </Grid.GestureRecognizers>

                                                <!-- DATA E HORÁRIO -->

                                                <Label
                                                  Grid.Column="0"
                                                  Text="{Binding DataHorario}"
                                                  FontSize="11"
                                                  LineBreakMode="WordWrap"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{StaticResource TextDark}" />

                                                <!-- MÉDICO -->

                                                <Label
                                                  Grid.Column="1"
                                                  Text="{Binding Medico}"
                                                  FontSize="11"
                                                  LineBreakMode="WordWrap"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{StaticResource TextDark}" />

                                                <!-- STATUS -->

                                                <Label
                                                  Grid.Column="2"
                                                  Text="{Binding Status}"
                                                  FontSize="11"
                                                  LineBreakMode="WordWrap"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{StaticResource PrimaryBlue}" />

                                            </Grid>

                                            <!-- LINHA DIVISÓRIA -->

                                            <BoxView
                                              HeightRequest="1"
                                              BackgroundColor="{StaticResource InputBlue}" />

                                        </VerticalStackLayout>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                        <Border IsVisible="{Binding SemConsultas}"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource InputBlue}"
                                StrokeThickness="1" Padding="14"
                                Margin="24,0,0,8" StrokeShape="RoundRectangle 12">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpanded}"
                                             Value="False">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="Nenhuma consulta encontrada para este paciente."
                                   FontSize="13" TextColor="{StaticResource InputPlaceholder}"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Text="Voltar"
            Grid.Row="2"
            Clicked="VoltarButton_Clicked"
            Style="{StaticResource BotaoVoltarSimples}" />
    </Grid>
</ContentPage>
