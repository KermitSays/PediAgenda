<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.AgendarDataHorario"
    Title="Data e horário"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,30,24,24" Spacing="22">
            <VerticalStackLayout Spacing="5">
                <Label Text="Escolha a data" FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}" />
                <Label Text="Selecione uma data e um horário disponível."
                       FontSize="16" TextColor="{StaticResource PrimaryBlue}" />
            </VerticalStackLayout>

            <!-- Dados do médico sem avatar e sem coluna vazia. -->
            <Border BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}" StrokeThickness="1"
                    Padding="16" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="MedicoLabel" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}" />
                    <Label x:Name="EspecialidadeLabel" FontSize="14"
                           TextColor="{StaticResource PrimaryBlue}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Data da consulta" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}" />
                <DatePicker x:Name="DataPicker" Format="dd/MM/yyyy" FontSize="16"
                            TextColor="{StaticResource TextDark}"
                            BackgroundColor="{StaticResource White}"
                            DateSelected="DataPicker_DateSelected" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Horários disponíveis" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}" />
                <FlexLayout x:Name="HorariosContainer" Direction="Row"
                            Wrap="Wrap" JustifyContent="Start" AlignItems="Start" />
                <Label x:Name="ErroHorarioLabel" TextColor="Red"
                       FontSize="14" IsVisible="False" />
            </VerticalStackLayout>

            <Button Text="CONTINUAR" HeightRequest="52" CornerRadius="14"
                    BackgroundColor="{StaticResource PrimaryBlue}"
                    TextColor="{StaticResource White}" FontAttributes="Bold"
                    Clicked="ContinuarButton_Clicked" />
            <Button
                Text="Voltar"
                Clicked="VoltarButton_Clicked"
                Style="{StaticResource BotaoVoltarSimples}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
