<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PediAgenda.Controls"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.MenuResponsavel"
    Title="PediAgenda"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,24"
            Spacing="22">


            <!-- CABEÇALHO -->

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <VerticalStackLayout Grid.Column="0" Spacing="4">

                <Label
                    x:Name="SaudacaoLabel"
                    Text="Olá!"
                    FontFamily="Poppins"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    Text="Como podemos ajudar?"
                    FontFamily="Poppins"
                    FontSize="20"
                    TextColor="{StaticResource PrimaryBlue}" />

                </VerticalStackLayout>
    <controls:BotaoLogoff Grid.Column="1" />
</Grid>


            <!-- ATALHOS -->

            <Grid
                RowDefinitions="Auto"
                ColumnDefinitions="*,*,*"
                RowSpacing="20"
                ColumnSpacing="20">


                <!-- AGENDAR -->

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="AgendarConsultaButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="agendar_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Agendar"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- MINHAS CONSULTAS -->

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="MinhasConsultasButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="consulta_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Minhas Consultas"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- PACIENTES -->

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="PacientesButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="paciente_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Pacientes"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


            </Grid>


            <!-- PRÓXIMA CONSULTA -->

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="Próximas consultas"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />


                <!-- QUANDO EXISTE CONSULTA -->
                <!-- LISTA DE PRÓXIMAS CONSULTAS -->

                <VerticalStackLayout
    x:Name="ProximasConsultasContainer"
    Spacing="10"
    IsVisible="False">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>

                            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                Padding="15"
                StrokeShape="RoundRectangle 15">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                        Tapped="ProximaConsulta_Tapped" />
                                </Border.GestureRecognizers>

                                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="4">

                                    <!-- MÉDICO -->
                                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="{Binding Consulta.Medico}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextDark}" />

                                    <!-- DATA E HORÁRIO -->
                                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Consulta.DataHorario}"
                        FontSize="14"
                        TextColor="{StaticResource PrimaryBlue}" />

                                    <!-- PACIENTE -->
                                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="{Binding Paciente.Nome}"
                        FontSize="13"
                        TextColor="{StaticResource InputPlaceholder}" />

                                    <!-- INDICADOR -->
                                    <Label
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Text="›"
                        FontSize="28"
                        VerticalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBlue}" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

                <!-- QUANDO NÃO EXISTE CONSULTA -->

                <Border
                    x:Name="SemConsultaCard"
                    IsVisible="False"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Text="Nenhuma consulta futura"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Você não possui consultas agendadas no momento."
                            FontSize="14"
                            TextColor="{StaticResource InputPlaceholder}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>