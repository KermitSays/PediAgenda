<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.MenuResponsavel"
    Title="PediAgenda"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,24"
            Spacing="22">


            <!-- CABEÇALHO -->

            <VerticalStackLayout
                Spacing="4">

                <Label
                    x:Name="SaudacaoLabel"
                    Text="Olá!"
                    FontFamily="Poppins"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    Text="Como podemos ajudar?"
                    FontFamily="Poppins"
                    FontSize="20"
                    TextColor="{StaticResource PrimaryBlue}" />

            </VerticalStackLayout>


            <!-- ATALHOS -->

            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,*"
                RowSpacing="20"
                ColumnSpacing="20">


                <!-- AGENDAR -->

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="AgendarConsultaButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="agendar_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Agendar"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- MINHAS CONSULTAS -->

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="MinhasConsultasButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="consulta_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Minhas Consultas"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- PACIENTES -->

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="PacientesButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="paciente_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Pacientes"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- NOTIFICAÇÕES -->

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="6"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="NotificacoesButton_Clicked" />

                    </VerticalStackLayout.GestureRecognizers>


                    <Image
                        Source="notificacao_icon.png"
                        WidthRequest="90"
                        HeightRequest="90"
                        Aspect="AspectFit" />


                    <Label
                        Text="Notificações"
                        TextColor="Black"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Grid>


            <!-- PRÓXIMA CONSULTA -->

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="Próxima consulta"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />


                <!-- QUANDO EXISTE CONSULTA -->

                <Border
                    x:Name="ProximaConsultaCard"
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout
                        Spacing="15">


                        <!-- MÉDICO -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">

                                <Image
                                    Source="user.png"
                                    WidthRequest="55"
                                    HeightRequest="55"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="2">

                                <Label
                                    x:Name="ProximoMedicoLabel"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                                <Label
                                    x:Name="ProximaEspecialidadeLabel"
                                    FontSize="15"
                                    TextColor="{StaticResource PrimaryBlue}" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- PACIENTE -->

                        <VerticalStackLayout
                            Spacing="2">

                            <Label
                                Text="paciente"
                                FontSize="13"
                                TextColor="{StaticResource InputPlaceholder}" />

                            <Label
                                x:Name="ProximoPacienteLabel"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                        </VerticalStackLayout>


                        <!-- INFORMAÇÕES -->

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="15"
                            RowSpacing="12">


                            <!-- DATA -->

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="data"
                                    FontSize="13"
                                    TextColor="{StaticResource InputPlaceholder}" />

                                <Label
                                    x:Name="ProximaDataLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                            </VerticalStackLayout>


                            <!-- HORÁRIO -->

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="horário"
                                    FontSize="13"
                                    TextColor="{StaticResource InputPlaceholder}" />

                                <Label
                                    x:Name="ProximoHorarioLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                            </VerticalStackLayout>


                            <!-- ATENDIMENTO -->

                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="tipo de atendimento"
                                    FontSize="13"
                                    TextColor="{StaticResource InputPlaceholder}" />

                                <Label
                                    x:Name="ProximaModalidadeLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                            </VerticalStackLayout>


                            <!-- STATUS -->

                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="status"
                                    FontSize="13"
                                    TextColor="{StaticResource InputPlaceholder}" />

                                <Border
                                    BackgroundColor="{StaticResource ResponsibleButton}"
                                    StrokeThickness="0"
                                    Padding="10,5"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Start">

                                    <Label
                                        x:Name="ProximoStatusLabel"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource ResponsibleText}" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- QUANDO NÃO EXISTE CONSULTA -->

                <Border
                    x:Name="SemConsultaCard"
                    IsVisible="False"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Text="Nenhuma consulta futura"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Você não possui consultas agendadas no momento."
                            FontSize="14"
                            TextColor="{StaticResource InputPlaceholder}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>