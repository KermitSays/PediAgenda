<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Responsavel.PacientesResponsavel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pacientes"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="24,30,24,24"
          RowDefinitions="Auto,*,Auto">

        <!-- TÍTULO -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="4">

            <Label Text="Meus dependentes"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}" />

            <Label Text="Consulte as informações cadastrais dos seus dependentes."
                   FontSize="15"
                   TextColor="{StaticResource InputPlaceholder}" />

        </VerticalStackLayout>

        <!-- LISTA DE DEPENDENTES -->
        <ScrollView Grid.Row="1"
                    Margin="0,24,0,15">

            <VerticalStackLayout Spacing="20">

                <CollectionView
                    x:Name="PacientesCollectionView"
                    ItemsSource="{Binding PacientesLista}"
                    SelectionMode="None"
                    HeightRequest="300">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="#E8F3FF"
                                Stroke="{StaticResource InputBlue}"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 16">

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="{Binding Nome}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextDark}" />

                                    <Label
                                        Text="{Binding Idade, StringFormat='Idade: {0} anos'}"
                                        FontSize="15"
                                        TextColor="{StaticResource PrimaryBlue}" />

                                    <Label
                                        Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}"
                                        FontSize="14"
                                        TextColor="{StaticResource TextDark}" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- ORIENTAÇÃO SOBRE CADASTRO -->
                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Informações cadastrais"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                        <Label
                            Text="Para cadastrar um novo dependente ou solicitar alterações cadastrais, entre em contato com a recepção da clínica."
                            FontSize="14"
                            TextColor="{StaticResource InputPlaceholder}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- BOTÃO VOLTAR -->
        <Button
            Grid.Row="2"
            Text="Voltar"
            Clicked="VoltarButton_Clicked"
            Style="{StaticResource BotaoVoltarSimples}" />

    </Grid>

</ContentPage>