<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PediAgenda.Views.Usuarios.Responsavel.PacientesResponsavel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pacientes"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="24,30,24,24" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Meus pacientes" FontSize="28" FontAttributes="Bold"
                   TextColor="{StaticResource TextDark}" />
            <Label Text="Consulte os dados e o histórico de cada paciente."
                   FontSize="15" TextColor="{StaticResource InputPlaceholder}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        x:Name="PacientesCollectionView"
                        ItemsSource="{Binding PacientesLista}"
                        Margin="0,24,0,15"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="10">
                        <!-- Sem foto/avatar: as informações ocupam toda a largura. -->
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource InputBlue}"
                                StrokeThickness="1" Padding="16"
                                StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PacienteCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Nome}" FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextDark}" />
                                <Label Text="{Binding Idade, StringFormat='{0} anos'}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryBlue}" />
                                <Label Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource InputPlaceholder}" />
                                <Label Text="Toque para ver o histórico" FontSize="12"
                                       TextColor="{StaticResource PrimaryBlue}"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsHistoricoExpanded}"
                                             Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource PrimaryBlue}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#E8F3FF" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding IsHistoricoExpanded}"
                                             Spacing="10" Padding="12,0,0,8">
                            <Label Text="Histórico de consultas" FontSize="17"
                                   FontAttributes="Bold" TextColor="{StaticResource TextDark}"
                                   Margin="8,4,0,2" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HistoricoConsultasOrdenado}"
                                                 Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Histórico só para leitura: sem ação de abrir detalhes. -->
                                        <Border BackgroundColor="{StaticResource White}"
                                                Stroke="{StaticResource InputBlue}"
                                                StrokeThickness="1" Padding="14"
                                                Margin="12,0,0,0"
                                                StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Medico}" FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextDark}" />
                                                <Label Text="{Binding Especialidade}" FontSize="13"
                                                       TextColor="{StaticResource PrimaryBlue}" />
                                                <Label Text="{Binding DataHorario}" FontSize="13"
                                                       TextColor="{StaticResource TextDark}" />
                                                <Label Text="{Binding Status}" FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource InputPlaceholder}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border IsVisible="{Binding SemHistorico}"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource InputBlue}"
                                    StrokeThickness="1" Padding="14"
                                    Margin="12,0,0,0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="Este paciente ainda não possui consultas no histórico."
                                       FontSize="13"
                                       TextColor="{StaticResource InputPlaceholder}"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Text="Voltar"
            Grid.Row="2"
            Clicked="VoltarButton_Clicked"
            Style="{StaticResource BotaoVoltarSimples}" />
    </Grid>
</ContentPage>
