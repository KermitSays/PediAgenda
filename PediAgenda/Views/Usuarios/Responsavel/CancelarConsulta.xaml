<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.CancelarConsulta"
    Title="Cancelar consulta"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,35" Spacing="18">

            <!-- CONFIRMAÇÃO DO CANCELAMENTO -->
            <VerticalStackLayout x:Name="CancelamentoContainer" Spacing="18">

                <Label
                    Text="Cancelar consulta"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    Text="Deseja realmente cancelar esta consulta?"
                    FontSize="15"
                    TextColor="{StaticResource TextDark}" />

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Resumo da consulta"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Médico" FontSize="12"
                                   TextColor="{StaticResource InputPlaceholder}" />
                            <Label x:Name="MedicoLabel" FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Especialidade" FontSize="12"
                                   TextColor="{StaticResource InputPlaceholder}" />
                            <Label x:Name="EspecialidadeLabel" FontSize="15"
                                   TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Paciente" FontSize="12"
                                   TextColor="{StaticResource InputPlaceholder}" />
                            <Label x:Name="PacienteLabel" FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Data" FontSize="12"
                                   TextColor="{StaticResource InputPlaceholder}" />
                            <Label x:Name="DataLabel" FontSize="15"
                                   TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Horário" FontSize="12"
                                   TextColor="{StaticResource InputPlaceholder}" />
                            <Label x:Name="HorarioLabel" FontSize="15"
                                   TextColor="{StaticResource TextDark}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="CancelarButton"
                    Text="CANCELAR CONSULTA"
                    HeightRequest="52"
                    CornerRadius="14"
                    BackgroundColor="{StaticResource PrimaryBlue}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    Clicked="CancelarButton_Clicked" />

                <Button
                    Text="Voltar"
                    Clicked="VoltarButton_Clicked"
                    Style="{StaticResource BotaoVoltarSimples}" />

            </VerticalStackLayout>

            <!-- RESULTADO DO CANCELAMENTO -->
            <VerticalStackLayout
                x:Name="ConclusaoContainer"
                IsVisible="False"
                Spacing="22"
                Padding="0,40,0,0">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label
                        Text="Consulta cancelada"
                        FontSize="28"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource TextDark}" />

                    <Label
                        Text="O cancelamento foi realizado com sucesso."
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource PrimaryBlue}" />
                </VerticalStackLayout>

                <Border
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="12">
                        <Label
                            x:Name="ResultadoHorarioLabel"
                            Text="A disponibilidade do horário foi atualizada."
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource TextDark}" />

                        <Label
                            Text="Para reagendar uma consulta, entre em contato com a recepção da clínica."
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource InputPlaceholder}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Voltar para minhas consultas"
                    Clicked="MinhasConsultasButton_Clicked"
                    Style="{StaticResource BotaoVoltarSimples}" />

                <Button
                    Text="Voltar ao menu inicial"
                    Clicked="MenuButton_Clicked"
                    Style="{StaticResource BotaoVoltarSimples}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
