<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.MinhasConsultasDetalhes"
    Title="Detalhes da consulta"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,24"
            Spacing="18">

            <!-- TÍTULO -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Detalhes da consulta"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}" />

                <Label
                    Text="Confira as informações do seu agendamento."
                    FontSize="15"
                    TextColor="{StaticResource TextDark}" />

            </VerticalStackLayout>


            <!-- INFORMAÇÕES DA CONSULTA -->
            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBlue}"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <!-- MÉDICO -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Médico"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="MedicoLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- ESPECIALIDADE -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Especialidade"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="EspecialidadeLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- PACIENTE -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Paciente"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="PacienteLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- DATA -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Data"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="DataLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- HORÁRIO -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Horário"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="HorarioLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- MODALIDADE -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Modalidade"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="ModalidadeLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- VALOR -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Valor"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="ValorLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextDark}" />

                    </VerticalStackLayout>


                    <!-- STATUS -->
                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Status"
                            FontSize="13"
                            TextColor="{StaticResource InputPlaceholder}" />

                        <Label
                            x:Name="StatusLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- REAGENDAR -->
            <Button
                Text="REAGENDAR CONSULTA"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="{StaticResource White}"
                FontAttributes="Bold"
                Clicked="ReagendarButton_Clicked" />


            <!-- CANCELAR -->
            <Button
                Text="CANCELAR CONSULTA"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="{StaticResource White}"
                BorderColor="{StaticResource PrimaryBlue}"
                BorderWidth="2"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                Clicked="CancelarButton_Clicked" />


            <!-- VOLTAR -->
            <Button
                Text="VOLTAR"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="Transparent"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>