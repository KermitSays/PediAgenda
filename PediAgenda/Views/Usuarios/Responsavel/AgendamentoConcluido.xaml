<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Usuarios.Responsavel.AgendamentoConcluido"
    Title="Agendamento concluído"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="22">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Consulta agendada!" FontSize="30"
                       FontAttributes="Bold" TextColor="{StaticResource TextDark}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Sua consulta foi agendada com sucesso."
                       FontSize="16" TextColor="{StaticResource PrimaryBlue}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource InputBlue}" StrokeThickness="1"
                    Padding="25,20" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Resumo da consulta" FontSize="21" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextDark}" />
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Responsável"
                           FontSize="13"
                           TextColor="{StaticResource InputPlaceholder}" />
                        <Label Text="{Binding Responsavel}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Paciente" FontSize="13" TextColor="{StaticResource InputPlaceholder}" />
                        <Label Text="{Binding Paciente}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Médico" FontSize="13" TextColor="{StaticResource InputPlaceholder}" />
                        <Label Text="{Binding Medico}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />
                        <Label Text="{Binding Especialidade}" FontSize="15"
                               TextColor="{StaticResource PrimaryBlue}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Data" FontSize="13" TextColor="{StaticResource InputPlaceholder}" />
                        <Label Text="{Binding Data}" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Horário" FontSize="13" TextColor="{StaticResource InputPlaceholder}" />
                        <Label Text="{Binding Horario}" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Para reagendar, entre em contato com a clínica. Para cancelar, acesse Minhas consultas."
                   FontSize="15" TextColor="{StaticResource TextDark}"
                   HorizontalTextAlignment="Center" />
            <Button Text="VER MINHAS CONSULTAS" HeightRequest="52" CornerRadius="14"
                    BackgroundColor="{StaticResource PrimaryBlue}"
                    TextColor="{StaticResource White}" FontAttributes="Bold"
                    Clicked="ConsultasButton_Clicked" />
            <Button
                Text="Voltar ao início"
                Clicked="MenuButton_Clicked"
                Style="{StaticResource BotaoVoltarSimples}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
