<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.Views.Cadastro.CadastroCampo"
    Title="Cadastro"
    BackgroundColor="{StaticResource PageBlue}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40,30,30"
            Spacing="18">

            <!-- Título -->
            <Label
                Text="Dados do responsável"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryBlue}"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <!-- Descrição -->
            <Label
                Text="Ative seu acesso ao PediAgenda com os dados cadastrados na clínica."
                FontSize="14"
                TextColor="{StaticResource TextDark}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10" />

            <!-- CPF -->
            <Label
                Text="CPF"
                FontSize="16"
                TextColor="{StaticResource TextDark}" />

            <Border Style="{StaticResource LoginBorder}">
                <Entry
                    x:Name="CpfEntry"
                    Style="{StaticResource LoginEntry}"
                    Placeholder="Insira seu CPF aqui"
                    Keyboard="Numeric"
                    MaxLength="14" />
            </Border>

            <!-- Código de ativação -->
            <Label
                Text="Código de ativação"
                FontSize="16"
                TextColor="{StaticResource TextDark}" />

            <Border Style="{StaticResource LoginBorder}">
                <Entry
                    x:Name="CodigoAtivacaoEntry"
                    Style="{StaticResource LoginEntry}"
                    Placeholder="Código fornecido pela clínica"
                    MaxLength="100" />
            </Border>

            <Label
                Text="Informe o código de ativação recebido durante seu cadastro na clínica."
                FontSize="12"
                TextColor="{StaticResource TextDark}" />

            <!-- E-mail -->
            <Label
                Text="E-mail"
                FontSize="16"
                TextColor="{StaticResource TextDark}" />

            <Border Style="{StaticResource LoginBorder}">
                <Entry
                    x:Name="EmailEntry"
                    Style="{StaticResource LoginEntry}"
                    Placeholder="Insira seu e-mail aqui"
                    Keyboard="Email"
                    MaxLength="160" />
            </Border>

            <!-- Senha -->
            <Label
                Text="Senha"
                FontSize="16"
                TextColor="{StaticResource TextDark}" />

            <Border Style="{StaticResource LoginBorder}">
                <Grid ColumnDefinitions="*,Auto">

                    <Entry
                        x:Name="SenhaEntry"
                        Grid.Column="0"
                        Style="{StaticResource LoginEntry}"
                        Placeholder="Insira sua senha aqui"
                        IsPassword="True" />

                    <!-- Botão de mostrar senha -->
                    <ImageButton
                        x:Name="MostrarSenhaButton"
                        Grid.Column="1"
                        Source="olho_fechado.png"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Clicked="MostrarSenhaButton_Clicked"
                        Padding="5"
                        Margin="0,0,10,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center" />

                </Grid>
            </Border>

            <!-- Confirmar senha -->
            <Label
                Text="Confirmar senha"
                FontSize="16"
                TextColor="{StaticResource TextDark}" />

            <Border Style="{StaticResource LoginBorder}">
                <Grid ColumnDefinitions="*,Auto">

                    <Entry
                        x:Name="ConfirmarSenhaEntry"
                        Grid.Column="0"
                        Style="{StaticResource LoginEntry}"
                        Placeholder="Confirme sua senha"
                        IsPassword="True" />

                    <!-- Botão de mostrar senha -->
                    <ImageButton
                        x:Name="MostrarConfirmarSenhaButton"
                        Grid.Column="1"
                        Source="olho_fechado.png"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Clicked="MostrarConfirmarSenhaButton_Clicked"
                        Padding="5"
                        Margin="0,0,10,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center" />

                </Grid>
            </Border>

            <!-- Termos de uso -->
            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">

                <CheckBox
                    x:Name="TermosCheckBox"
                    Color="{StaticResource PrimaryBlue}" />

                <Label
                    Text="Concordo com os Termos de Uso"
                    FontSize="14"
                    TextColor="{StaticResource TextDark}"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <!-- Mensagem de erro -->
            <Label
                x:Name="MensagemErroLabel"
                Text=""
                FontSize="14"
                TextColor="Red"
                IsVisible="False"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <!-- Botão continuar -->
            <Button
                x:Name="ContinuarButton"
                Text="CONTINUAR"
                Style="{StaticResource PrimaryButton}"
                Clicked="ContinuarButton_Clicked"
                Margin="0,10,0,0" />

            <!-- Voltar -->
            <Button
                x:Name="VoltarButton"
                Text="← Voltar"
                BackgroundColor="Transparent"
                TextColor="{StaticResource PrimaryBlue}"
                FontSize="16"
                Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
