<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PediAgenda.MainPage"
    Title="PediAgenda"
    BackgroundColor="#FAF9FC"
    Shell.NavBarIsVisible="False">

    <Grid Padding="24,24,24,16"
          RowDefinitions="*,Auto"
          RowSpacing="10">

        <!-- Conteúdo principal -->
        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Spacing="0">

                <!-- Logo com o nome PediAgenda -->
                <Image Source="pediagenda_logo.png"
                       WidthRequest="300"
                       HeightRequest="300"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <!-- Slogan -->
                <Label Text="Cuidando de quem&#10;importa."
                       TextColor="{StaticResource TextDark}"
                       FontSize="21"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       LineHeight="1.0"
                       Margin="0,10,0,0" />

                <!-- Escolher Login -->
                <Label Text="Como você deseja&#10;acessar?"
                       TextColor="{StaticResource EmployeeText}"
                       FontSize="25"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Margin="0,45,0,24" />

                <!-- Botões -->
                <VerticalStackLayout Spacing="20">

                    <!-- Botão Responsável -->
                    <Button Text="Sou Responsável"
                            HeightRequest="70"
                            CornerRadius="35"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{StaticResource ResponsibleText}"
                            BackgroundColor="{StaticResource ResponsibleButton}"
                            Clicked="OnResponsavelClicked" />

                    <!-- Botão Funcionário -->
                    <Button Text="Sou Funcionário"
                            HeightRequest="70"
                            CornerRadius="35"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{StaticResource EmployeeText}"
                            BackgroundColor="{StaticResource EmployeeButton}"
                            Clicked="OnFuncionarioClicked" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Sobre os desenvolvedores -->
        <Button Grid.Row="1"
                Text="Sobre os desenvolvedores"
                Style="{StaticResource BotaoVoltarSimples}"
                FontAttributes="Italic"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,4,0,0"
                Clicked="SobreDesenvolvedoresButton_Clicked" />

    </Grid>

</ContentPage>
